#!/usr/bin/python3
"""memory-guard: ask which apps to close before systemd-oomd picks one for you.

Watches memory pressure on the user session (the same signal systemd-oomd acts
on). When it gets high, shows a dialog that lists your apps by memory use and
lets you tick the ones to close, like macOS's "Force Quit Applications" window.

Usage:
  memory-guard            run the watcher (normally via memory-guard.service)
  memory-guard --list     print the apps the dialog would offer, then exit
  memory-guard --test     show the dialog now (closes nothing), then exit
"""
import os
import re
import subprocess
import sys
import time

UID = os.getuid()
SESSION_CG = f"/sys/fs/cgroup/user.slice/user-{UID}.slice/user@{UID}.service"

# systemd-oomd kills when "full" pressure is above 50% for 20s (Ubuntu's
# user@.service default). Ask well before that.
WARN_PRESSURE = float(os.environ.get("MG_WARN_PRESSURE", 20))  # full avg10, %
WARN_SECONDS = int(os.environ.get("MG_WARN_SECONDS", 6))       # sustained for
LOW_AVAILABLE_MB = int(os.environ.get("MG_LOW_AVAILABLE_MB", 2048))  # RAM+swap left
POLL = 2
SNOOZE = 120          # after "Not now", stay quiet this long...
SNOOZE_OVERRIDE = 40  # ...unless pressure climbs past this
MIN_APP_MB = 50       # don't list tiny cgroups

# Where killable things live. session.slice and init.scope are the desktop.
APP_PARENTS = ("app.slice", "devtracker.slice", "background.slice")


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ""


def full_pressure():
    m = re.search(r"full avg10=([\d.]+)", read(f"{SESSION_CG}/memory.pressure"))
    return float(m.group(1)) if m else 0.0


def available_mb():
    info = dict(
        (k, int(v.split()[0]))
        for k, v in (line.split(":", 1) for line in read("/proc/meminfo").splitlines())
    )
    return (info.get("MemAvailable", 0) + info.get("SwapFree", 0)) // 1024


def omitted(path):
    try:
        return "user.oomd_omit" in os.listxattr(path)
    except OSError:
        return False


def unescape(name):
    return re.sub(r"\\x([0-9a-f]{2})", lambda m: chr(int(m.group(1), 16)), name)


def desktop_name(app_id):
    for base in (os.path.expanduser("~/.local/share"), "/usr/local/share", "/usr/share",
                 "/var/lib/snapd/desktop", "/var/lib/flatpak/exports/share"):
        text = read(f"{base}/applications/{app_id}.desktop")
        m = re.search(r"^Name=(.+)$", text, re.M)
        if m:
            return m.group(1).strip()
    return None


def pids(path):
    out = []
    for root, _dirs, _files in os.walk(path):
        out += [int(p) for p in read(f"{root}/cgroup.procs").split()]
    return out


def biggest_cmd(path):
    best, best_rss = None, -1
    for pid in pids(path):
        m = re.search(r"VmRSS:\s+(\d+)", read(f"/proc/{pid}/status"))
        rss = int(m.group(1)) if m else 0
        if rss > best_rss:
            best, best_rss = pid, rss
    if best is None:
        return "?"
    cmd = read(f"/proc/{best}/cmdline").replace("\0", " ").strip()
    return cmd or read(f"/proc/{best}/comm").strip()


def label(unit, path):
    name = unescape(unit)
    # app-gnome-<app id>-<pid>.scope, app-<app id>@<random>.service, ...
    m = re.match(r"app-(?:gnome|flatpak|snap)?-?(.+?)(?:-\d+)?\.(?:scope|service)$", name)
    if name.startswith("vte-spawn-"):
        return f"Terminal tab: {biggest_cmd(path)[:70]}"
    if name.startswith("devtracker-run-"):
        return f"DevTracker run {name.split('-')[-2][:8]}"
    if name.startswith("snap."):
        return f"{name.split('.')[1].capitalize()} (snap)"
    if m:
        app_id = m.group(1).split("@")[0]
        pretty = desktop_name(app_id)
        if pretty:
            return pretty
        # jetbrains-webstorm-b1233d18-... -> jetbrains-webstorm
        return re.sub(r"-[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$", "", app_id)
    return name.rsplit(".", 1)[0]


def candidates():
    """Leaf cgroups under the app slices, biggest first: (mb, unit, label)."""
    found = []
    for parent in APP_PARENTS:
        for root, dirs, _files in os.walk(f"{SESSION_CG}/{parent}"):
            unit = os.path.basename(root)
            if not unit.endswith((".scope", ".service")) or omitted(root):
                continue
            dirs[:] = []  # a unit's sub-cgroups belong to it
            mb = int(read(f"{root}/memory.current") or 0) // 2**20
            if mb >= MIN_APP_MB:
                found.append((mb, unit, label(unit, root)))
    found.sort(reverse=True)
    return found


def fmt_mb(mb):
    return f"{mb / 1024:.1f} GB" if mb >= 1024 else f"{mb} MB"


def ask(reason, dry_run=False):
    apps = candidates()
    if not apps:
        return
    subprocess.run(["notify-send", "-u", "critical", "-i", "dialog-warning",
                    "Memory is running low", "Choose apps to close before the system does."])
    rows = []
    for i, (mb, unit, name) in enumerate(apps):
        rows += ["TRUE" if i == 0 else "FALSE", fmt_mb(mb), name, unit]
    res = subprocess.run(
        ["zenity", "--list", "--checklist", "--title=Memory is running low",
         f"--text={reason}\nIf nothing is closed, the system may close an app on its own.\n"
         "Tick the apps to close:",
         "--width=640", "--height=440", "--timeout=120",
         "--ok-label=Close selected", "--cancel-label=Not now",
         "--column=Close", "--column=Memory", "--column=App", "--column=Unit",
         "--hide-column=4", "--print-column=4", "--separator=\n", *rows],
        capture_output=True, text=True)
    chosen = [u for u in res.stdout.split("\n") if u.strip()] if res.returncode == 0 else []
    if dry_run:
        msg = "\n".join(unescape(u) for u in chosen) or "nothing"
        subprocess.run(["zenity", "--info", "--title=Test run",
                        f"--text=Test run, nothing was closed. Would have stopped:\n{msg}"])
        return False
    for unit in chosen:
        # stop = SIGTERM, then SIGKILL after the unit's timeout, so apps can save.
        subprocess.run(["systemctl", "--user", "stop", "--no-block", unit])
    return bool(chosen)


def watch():
    high_since = None
    snoozed_until = 0.0
    while True:
        p, avail = full_pressure(), available_mb()
        now = time.monotonic()
        pressing = p >= WARN_PRESSURE or avail < LOW_AVAILABLE_MB
        high_since = (high_since or now) if pressing else None
        if (high_since and now - high_since >= WARN_SECONDS
                and (now >= snoozed_until or p >= SNOOZE_OVERRIDE)):
            reason = (f"Memory pressure is {p:.0f}% and {fmt_mb(avail)} of RAM and swap "
                      "is left.")
            closed = ask(reason)
            high_since = None
            # give a closed app time to exit before judging pressure again
            snoozed_until = time.monotonic() + (20 if closed else SNOOZE)
        time.sleep(POLL)


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--list":
        print(f"pressure full avg10={full_pressure():.1f}%  available={fmt_mb(available_mb())}")
        for mb, unit, name in candidates():
            print(f"{fmt_mb(mb):>9}  {name}  [{unescape(unit)}]")
    elif arg == "--test":
        ask("Test run: nothing is wrong right now, and nothing will be closed.", dry_run=True)
    elif arg in ("", "--watch"):
        watch()
    else:
        print(__doc__.strip())
        sys.exit(2)


if __name__ == "__main__":
    main()
